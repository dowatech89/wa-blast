# Supabase (Project Settings > API). Anon key is public; never put the service_role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Same two values for the dashboard (Vite reads VITE_*)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WABlast.exe (agent). GOWA credentials are generated fresh on every start.
GOWA_PORT=3100
WEBHOOK_PORT=3101
TICK_SECONDS=3
SIGNED_URL_SECONDS=600

# Only for running GOWA by hand during development (tools/gowa)
GOWA_BASIC_AUTH=admin:change-me
